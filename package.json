{
  "name": "npm2exe",
  "version": "0.2.0",
  "license": "LGPL-2.1-or-later",
  "author": "shiy2008@gmail.com",
  "description": "Pack a JavaScript local project to a Portable Executable",
  "keywords": [
    "pack",
    "portable",
    "zx",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/idea2app/npm2exe"
  },
  "type": "module",
  "bin": {
    "npm2exe": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "7zip-bin-full": "^26.3.1",
    "commander-jsx": "^0.8.0",
    "fast-glob": "^3.3.3",
    "gitignore-to-glob": "^0.3.0",
    "ink": "^7.1.1",
    "koajax": "^3.3.1",
    "react": "^19.3.0",
    "semver": "^7.8.5",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/semver": "^7.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pkgroll": "^2.28.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none",
    "arrowParens": "avoid"
  },
  "lint-staged": {
    "*.{md,json,js,jsx,ts,tsx}": "prettier --write"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "lint-staged",
    "build": "pkgroll",
    "test": "npm run build  &&  tsx src/ .  &&  out/npm2exe  &&  ~/npm2exe -h  &&  pnpm --dir test-packages --filter test-child test",
    "test-win": "npm run build  &&  tsx src/ .  &&  out\\npm2exe.exe -y  &&  %USERPROFILE%\\npm2exe -h  &&  pnpm --dir test-packages --filter test-child test",
    "prepublishOnly": "npm run build"
  }
}
